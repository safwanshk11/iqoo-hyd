# Neon PostgreSQL connection string. Keep this file local and never commit secrets.
DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/parkly?sslmode=require
PORT=3001

# Optional public API URL for hosted-API APK builds; web defaults to /api.
# VITE_API_URL=https://parkly-api-pslb.onrender.com/api
# Exact extra frontend origins, comma separated. Never use a wildcard with cookies.
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,capacitor://localhost
