{
  "name": "parkly",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:install": "npm run android:apk && adb reverse tcp:3001 tcp:3001 && adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:neon": "node scripts/test-neon.js",
    "admin:grant": "node server/admin.js"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "@huggingface/transformers": "^4.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@types/leaflet": "^1.9.16",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.1.2",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
